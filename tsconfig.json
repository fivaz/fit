{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@/lib/*": ["./apps/web/lib/*"],
			"@/tests/*": ["./tests/*"]
		}
	},
	"include": [
		"tests/**/*.ts",
		"demos/**/*.ts",
		"playwright.config.ts",
		"playwright.demo.config.ts",
		"playwright.shared.ts"
	]
}
