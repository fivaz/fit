{
	"name": "fit",
	"version": "1.28.0",
	"private": true,
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "pnpm --parallel --filter @fit/api --filter @fit/web dev",
		"dev:web": "pnpm --filter @fit/web dev",
		"dev:api": "pnpm --filter @fit/api dev",
		"dev:lan": "pnpm --parallel --filter @fit/api --filter @fit/web dev:lan",
		"build": "pnpm --filter @fit/shared build && pnpm --filter @fit/api build && pnpm --filter @fit/web build",
		"build:static": "pnpm --filter @fit/web build:static",
		"export:static": "pnpm run build:static",
		"ios:build": "pnpm --filter @fit/web ios:build",
		"ios:build:deploy": "pnpm --filter @fit/web ios:build:deploy",
		"ios:deploy": "pnpm --filter @fit/web ios:deploy",
		"tunnel:dev": "cloudflared tunnel run fit-dev",
		"ios:copy": "pnpm --filter @fit/web ios:copy",
		"ios:open": "pnpm --filter @fit/web ios:open",
		"ios:readiness": "pnpm --filter @fit/web ios:readiness",
		"ios:sync": "pnpm --filter @fit/web ios:sync",
		"start": "pnpm --parallel --filter @fit/api --filter @fit/web start",
		"lint": "pnpm -r --if-present lint",
		"format": "prettier --write . && pnpm -r --if-present lint --fix",
		"tsc": "pnpm -r --if-present exec tsc --noEmit --watch",
		"db:setup": "pnpm --filter @fit/api db:setup",
		"db:reset": "pnpm --filter @fit/api db:reset",
		"db:full-reset": "pnpm --filter @fit/api db:full-reset",
		"db:deploy": "pnpm --filter @fit/api db:deploy",
		"db:seed": "pnpm --filter @fit/api db:seed",
		"db:generate": "pnpm --filter @fit/api db:generate",
		"postinstall": "pnpm --filter @fit/api db:generate && pnpm --filter @fit/shared build",
		"prepare": "husky",
		"act:release": "act -W .github/workflows/release.yml",
		"act:e2e": "act -W .github/workflows/e2e.yml",
		"act:prune-cache": "rm -rf .act-cache",
		"exercises-seed": "pnpm --filter @fit/api exercises-seed",
		"generate-ios-assets": "pnpm --filter @fit/web generate-ios-assets",
		"generate-pwa-assets": "pnpm --filter @fit/web generate-pwa-assets",
		"pretest": "node scripts/free-dev-server-port.mjs",
		"test:e2e": "pnpm run pretest && PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
		"test": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e",
		"test:unit": "pnpm --filter @fit/api test:unit",
		"agent": "agent worker start"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@playwright/test": "^1.61.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"semantic-release": "^25.0.2",
		"semantic-release-pnpm": "^1.0.2",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
