{
	"name": "fit",
	"version": "1.28.0",
	"private": true,
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "next dev",
		"dev:lan": "next dev --hostname 0.0.0.0",
		"build": "next build",
		"build:static": "node scripts/build-static.mjs",
		"export:static": "pnpm run build:static",
		"ios:build": "pnpm run generate-ios-assets && pnpm run build:static && pnpm exec cap sync ios",
		"ios:build:deploy": "pnpm run ios:build && node scripts/ios-deploy.mjs",
		"ios:deploy": "node scripts/ios-deploy.mjs",
		"tunnel:dev": "cloudflared tunnel run fit-dev",
		"ios:copy": "pnpm exec cap copy ios",
		"ios:open": "pnpm exec cap open ios",
		"ios:readiness": "node scripts/ios-readiness-check.mjs",
		"ios:sync": "pnpm exec cap sync ios",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write . && eslint --fix .",
		"tsc": "tsc --noEmit --watch",
		"db:setup": "prisma migrate dev",
		"db:reset": "pnpm prisma migrate reset --force",
		"db:full-reset": "pnpm run db:reset && pnpm run db:seed",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:generate": "prisma generate",
		"postinstall": "prisma generate",
		"prepare": "husky",
		"act:release": "act -W .github/workflows/release.yml",
		"act:e2e": "act -W .github/workflows/e2e.yml",
		"act:prune-cache": "rm -rf .act-cache",
		"exercises-seed": "tsx scripts/exercises-seed.ts",
		"generate-ios-assets": "node scripts/generate-ios-assets.mjs",
		"generate-pwa-assets": "pwa-assets-generator",
		"pretest": "node scripts/free-dev-server-port.mjs",
		"test:e2e": "pnpm run pretest && PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
		"test": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e",
		"test:unit": "node --import tsx --test lib/program/generate.test.ts",
		"agent": "agent worker start"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.29",
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/core": "^8.3.2",
		"@capacitor/keyboard": "^8.0.3",
		"@capacitor/network": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "^8.0.2",
		"@dnd-kit/helpers": "^0.2.1",
		"@dnd-kit/react": "^0.2.1",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@sentry/cli": "^3.1.0",
		"@sentry/nextjs": "^10",
		"ai": "^7.0.51",
		"better-auth": "^1.4.9",
		"capacitor-live-activity": "^8.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"dotenv": "^17.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-storybook": "^10.1.11",
		"eslint-plugin-unused-imports": "^4.3.0",
		"framer-motion": "^12.26.1",
		"lucide-react": "^0.562.0",
		"next": "16.1.7",
		"next-themes": "^0.4.6",
		"pg": "^8.16.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"swr": "^2.3.8",
		"tailwind-merge": "^3.4.0",
		"usehooks-ts": "^3.1.1",
		"vaul": "^1.1.2",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.3.2",
		"@capacitor/ios": "^8.3.2",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@playwright/test": "^1.61.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/pg": "^8.16.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vite-pwa/assets-generator": "^0.2.6",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"eslint": "^9",
		"eslint-config-next": "16.1.1",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prisma": "^7.2.0",
		"semantic-release": "^25.0.2",
		"semantic-release-pnpm": "^1.0.2",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5"
	}
}
