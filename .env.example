# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# postgres db
DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=public

#better-auth
# run openssl rand -base64 32 to generate a new secret
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated extra origins for Better Auth (in addition to BETTER_AUTH_URL).
# In development, `http://localhost:3000` is allowed by default in lib/auth.ts (same port as `pnpm dev` and Playwright).
# Capacitor WebView origins (`capacitor://localhost`, etc.) are always included for native builds.
#BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Better Auth public URL when the app is opened from another machine (e.g. physical phone on LAN).
#BETTER_AUTH_URL=http://192.168.1.4:3000

# Port used by `next dev` and by `scripts/free-dev-server-port.mjs` (Playwright `pretest`). Default 3000. Legacy: E2E_DEV_PORT.
#DEV_SERVER_PORT=3000

# Optional: extra origins for `/api/*` CORS (see `lib/cors.ts`). Capacitor shells and `BETTER_AUTH_URL` origin are built in.
#CORS_ALLOWED_ORIGINS=https://staging.example.com

# OAuth credentials for Google and GitHub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth credentials for GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# test user email for demo mode, the ModeToggle component is only available for this user to make it easier to change the mode when demoing the app
NEXT_PUBLIC_DEMO_USER_EMAIL=test@test.com

# Verbose Safari/Capacitor logs (`[FitClient:*]` via `lib/mobile/client-debug.ts`). Or set in Web Inspector:
# localStorage.setItem("fit:client-debug","1") then reload (no rebuild).
#NEXT_PUBLIC_CLIENT_DEBUG=1

# Offline cache + mutation queue + local fallbacks (`lib/offline/*`). Set `false` while testing iOS against a live API.
#NEXT_PUBLIC_OFFLINE_ENABLED=false

# --- Web (default): leave unset so the browser uses same-origin `/api/*` and `/api/auth/*`. ---

# --- Capacitor / static bundle: API + auth on another origin ---
# `NEXT_PUBLIC_*` are inlined when you run `pnpm ios:build`. Change them → rebuild the static bundle.
# `BETTER_AUTH_URL` is read at **server** runtime (`pnpm dev` / `pnpm start`); keep its origin aligned with the URLs below.
#NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#NEXT_PUBLIC_AUTH_BASE_URL=https://api.example.com
#BETTER_AUTH_URL=https://api.example.com

# --- Capacitor + iOS Simulator, API on this Mac (`pnpm dev` on port 3000) ---
#NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
#NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:3000
#BETTER_AUTH_URL=http://127.0.0.1:3000

# Physical device on Wi‑Fi: same three variables, but use your Mac’s LAN IP (not 127.0.0.1).
# Optional: add that origin here if you use a non-default host for Better Auth CSRF checks.
#BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.10:3000
