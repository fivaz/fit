# Fit Tracker — environment variables
# Copy to `.env` and fill in values. See README.md → "Static/mobile (Capacitor) environment".

# =============================================================================
# REQUIRED — web app (`pnpm dev`, `pnpm start`, Playwright)
# =============================================================================

# PostgreSQL connection string (Prisma). See https://pris.ly/d/connection-strings
DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=public

# Better Auth signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Public URL of this Next.js server. Used by Better Auth on the server and for browser same-origin /api/*.
# For Capacitor/iOS, keep this origin aligned with NEXT_PUBLIC_AUTH_BASE_URL (or MOBILE_DEV_URL).
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# REQUIRED — iOS / Capacitor static build (`pnpm ios:build`, `pnpm ios:build:deploy`)
# =============================================================================
# The iOS WebView origin is `capacitor://localhost` — it cannot call same-origin /api/* or /api/auth/*.
# Set remote http(s) URLs below. Values are inlined at build time; after any change, rerun `pnpm ios:build`.
# `scripts/build-static.mjs` fails early if both client URLs are missing.
#
# Provide either:
#   • NEXT_PUBLIC_API_BASE_URL + NEXT_PUBLIC_AUTH_BASE_URL, or
#   • MOBILE_DEV_URL (fallback for both when the specific vars are unset)

#NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#NEXT_PUBLIC_AUTH_BASE_URL=https://api.example.com

# Single-origin shortcut (tunnel, LAN, or hosted API):
#MOBILE_DEV_URL=https://api.example.com

# The machine running the API must expose BETTER_AUTH_URL with the same origin as AUTH base above
# (on a hosted deploy, set this in the server environment — not only in your local .env).

# =============================================================================
# SETUP RECIPES — uncomment the block that matches how you run the app
# =============================================================================

# --- Web only (browser on this machine) ---
# DATABASE_URL + BETTER_AUTH_SECRET + BETTER_AUTH_URL above are enough.
# Leave Capacitor vars unset — the browser uses same-origin /api/* and /api/auth/*.

# --- iOS Simulator + API on this Mac (`pnpm dev` on port 3000) ---
#NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
#NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:3000
#BETTER_AUTH_URL=http://127.0.0.1:3000

# --- iOS + remote hosted API (production or staging) ---
#MOBILE_DEV_URL=https://fit.example.com
# On the hosted server: BETTER_AUTH_URL=https://fit.example.com

# --- iOS physical device + API on Mac over Wi‑Fi (replace with your Mac's LAN IP) ---
#NEXT_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
#NEXT_PUBLIC_AUTH_BASE_URL=http://192.168.1.10:3000
#BETTER_AUTH_URL=http://192.168.1.10:3000

# --- Capacitor live reload (WebView loads dev server instead of `.next-static/`) ---
# 1. `pnpm dev`  2. tunnel or LAN URL  3. `pnpm ios:sync` or `pnpm ios:build`
#MOBILE_DEV_URL=https://dev.example.com
#CAPACITOR_SERVER_URL=https://dev.example.com
# Run named tunnel: pnpm tunnel:dev  (see config/cloudflared.dev.yml)

# =============================================================================
# OPTIONAL — OAuth (social login)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# OPTIONAL — networking / auth
# =============================================================================

# Extra Better Auth CSRF origins (comma-separated). Capacitor origins are built into lib/auth.ts.
#BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.10:3000

# Extra allowed Origin values for /api/* CORS (lib/cors.ts). Capacitor + BETTER_AUTH_URL origin are built in.
#CORS_ALLOWED_ORIGINS=https://staging.example.com

# Extra hostnames for Next.js dev HMR when using a tunnel (MOBILE_DEV_URL hostname is added automatically).
#NEXT_ALLOWED_DEV_ORIGINS=dev.example.com

# =============================================================================
# OPTIONAL — iOS CLI deploy (`pnpm ios:build:deploy`, `pnpm ios:deploy`)
# =============================================================================
# Device config: copy ios-deploy.config.example.json → ios-deploy.config.json (gitignored).

# Override iPhone UDID (`xcrun devicectl list devices`). Set IOS_DEPLOY_SKIP=1 to skip install.
#IOS_DEPLOY_DEVICE_ID=

# Fail deploy when no paired iPhone is reachable (default: skip install with exit 0).
#IOS_DEPLOY_REQUIRED=1

# =============================================================================
# OPTIONAL — development, debugging, and seeds
# =============================================================================

# Port for `pnpm dev` and Playwright pretest (default 3000). Legacy alias: E2E_DEV_PORT.
#DEV_SERVER_PORT=3000

# Demo mode toggle visibility (ModeToggle) — only shown for this email.
NEXT_PUBLIC_DEMO_USER_EMAIL=test@test.com

# Verbose Capacitor/Safari logs ([FitClient:*]). Or in Web Inspector:
# localStorage.setItem("fit:client-debug","1"); location.reload();
#NEXT_PUBLIC_CLIENT_DEBUG=1

# Offline cache + mutation queue (lib/offline/*). Set false while testing iOS against a live API only.
#NEXT_PUBLIC_OFFLINE_ENABLED=false

# CDN URL for `pnpm db:seed` exercise import (scripts/exercises-seed.ts).
#EXERCISE_SEED_URL=https://cdn.example.com/exercises/seed.json

# =============================================================================
# OPTIONAL — AI coach program generation
# =============================================================================

# Google Gemini API key for AI program generation (POST /api/programs/generate).
#GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override (default: gemini-2.0-flash).
#AI_PROGRAM_MODEL=gemini-2.0-flash
