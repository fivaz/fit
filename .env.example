# Local overrides (loaded by Next.js; takes precedence over `.env`).
# Prisma still needs DATABASE_URL available to its process (often via `.env`).

# --- Database ---
# Local Postgres (commented; switch for offline DB work)
#DATABASE_URL=
# Neon remote Postgres (Prisma)
DATABASE_URL=
# Alternate Prisma-hosted DB (commented)
#DATABASE_URL=

# --- Auth ---
# Better Auth session signing secret (generate one with the command: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Google OAuth client ID
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# GitHub OAuth client ID
GITHUB_CLIENT_ID=
# GitHub OAuth client secret
GITHUB_CLIENT_SECRET=

# --- Exercise / fitness APIs ---
# ExerciseDB RapidAPI key (active)
EXERCISE_DB_API_KEY=
# Wrkout API key
WRKOUT_KEY=
# CDN URL for exercise seed JSON (`pnpm db:seed`)
EXERCISE_SEED_URL=

# --- AI ---
# OpenAI API key
OPENAI_API_KEY=

# --- Cloudflare R2 / assets ---
# R2 access key ID
ACCESS_KEY_ID=
# R2 secret access key
SECRET_ACCESS_KEY=
# Cloudflare API / upload token
TOKEN_VALUE=
# R2 S3-compatible endpoint (bucket path)
S3=
# Public CDN base URL for assets
NEXT_PUBLIC_ASSET_URL=
# Cloudflare account ID
CLOUDFLARE_ACCOUNT_ID=

# --- App / client ---
# Email that can see the demo mode toggle
NEXT_PUBLIC_DEMO_USER_EMAIL=
# Offline cache + mutation queue (false = always hit live API)
NEXT_PUBLIC_OFFLINE_ENABLED=
# Verbose client debug logs (0 = off, 1 = on)
NEXT_PUBLIC_CLIENT_DEBUG=

# --- Mobile / Capacitor use cases ---
# Web only: leave MOBILE_DEV_URL unset and run `pnpm dev`
#MOBILE_DEV_URL=

# Local client + local API (hot reload via tunnel/LAN)
#MOBILE_DEV_URL=
# then: pnpm dev:lan && pnpm tunnel:dev && pnpm ios:build:deploy

# Remote client + remote API (active)
MOBILE_DEV_URL=
# then: pnpm ios:build:deploy

# Local client + remote API (explicit base URLs)
#NEXT_PUBLIC_API_BASE_URL=
#NEXT_PUBLIC_AUTH_BASE_URL=

# Other MOBILE_DEV_URL options
#MOBILE_DEV_URL=
#MOBILE_DEV_URL=
#MOBILE_DEV_URL=
