# Local overrides (loaded from repo root by Next and Nest).

# --- Database ---
DATABASE_URL=

# --- Auth (API origin) ---
# Better Auth session signing secret (generate one with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,capacitor://localhost,ionic://localhost,http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- CORS (browser web app origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=3001

# --- Exercise / fitness APIs ---
EXERCISE_DB_API_KEY=
WRKOUT_KEY=
EXERCISE_SEED_URL=

# --- AI ---
OPENAI_API_KEY=

# --- Cloudflare R2 / assets ---
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
TOKEN_VALUE=
S3=
NEXT_PUBLIC_ASSET_URL=
CLOUDFLARE_ACCOUNT_ID=

# --- App / client ---
NEXT_PUBLIC_DEMO_USER_EMAIL=
NEXT_PUBLIC_OFFLINE_ENABLED=
NEXT_PUBLIC_CLIENT_DEBUG=

# Web and local Simulator without a tunnel (defaults to :3001 in Next dev if unset)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3001

# --- Mobile / Capacitor ---
# Live-reload WebView origin only (not the API). Unset for local web (`pnpm dev`).
#MOBILE_DEV_URL=https://dev.sfivaz.com
#CAPACITOR_SERVER_URL=

# HTTPS tunnel (same named tunnel, two hostnames — see config/cloudflared.dev.yml):
#MOBILE_DEV_URL=https://dev.sfivaz.com
#NEXT_PUBLIC_API_BASE_URL=https://api-dev.sfivaz.com
#NEXT_PUBLIC_AUTH_BASE_URL=https://api-dev.sfivaz.com
#BETTER_AUTH_URL=https://api-dev.sfivaz.com
#CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dev.sfivaz.com
#BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://dev.sfivaz.com,capacitor://localhost,ionic://localhost,http://localhost
