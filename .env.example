# Local overrides (loaded from repo root by Next and Nest).
# For Azure deployment: Secrets are stored in Azure Key Vault, not .env files

# =============================================================
# Core — required to run the app (web + API) in local dev
# =============================================================

# --- Database ---
DATABASE_URL=

# --- Auth ---
# Better Auth session signing secret (generate one with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# --- CORS (browser web app origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=3001

# --- App / API origins ---
# App = Capacitor live-reload / Next origin. Unset for local web (`pnpm dev`).
# API = Nest + Better Auth. NEXT_PUBLIC_* and BETTER_AUTH_URL inherit this.
API_BASE_URL=http://localhost:3001

# --- AI program generation ---
OPENAI_API_KEY=
# Optional model override, defaults to gpt-4o-mini
#AI_PROGRAM_MODEL=

# --- Billing (Stripe, test mode) ---
# Canonical web app origin, used to build Stripe Checkout success/cancel redirect URLs
WEB_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the one-time credit-pack Price, created in the Stripe Dashboard (test mode)
STRIPE_CREDIT_PACK_PRICE_ID=

# =============================================================
# Optional — only needed for specific features or workflows
# =============================================================

# --- Demo clips → R2 (`pnpm demo:publish`) ---
# R2 API token limited to Object Read & Write on the CDN bucket only.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
# Optional: key prefix inside the bucket, and the public origin serving it
#R2_DEMO_PREFIX=portfolio/fit
#CDN_BASE_URL=https://cdn.sfivaz.com

# --- Social auth (email/password works without these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple (web redirect + native iOS sheet). A provider is only enabled when all of its
# required values are set.
#   APPLE_CLIENT_ID: Services ID (web flow); its return URL must be https://<api-origin>/api/auth/callback/apple
#   APPLE_PRIVATE_KEY: contents of the Sign in with Apple .p8 key (literal \n allowed on one line)
#   APPLE_APP_BUNDLE_ID: iOS bundle id, the audience of native ID tokens
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_ID=com.fivaz.fittracker
# Native iOS Google sign-in (web client id = GOOGLE_CLIENT_ID; iOS client id is a separate OAuth client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Comma-separated extra origins Better Auth should trust beyond CORS_ALLOWED_ORIGINS
#BETTER_AUTH_TRUSTED_ORIGINS=

# --- Exercise seeding (`pnpm db:seed`) ---
EXERCISE_SEED_URL=

# --- Demo / debug / offline toggles ---
# Email that can see the demo mode toggle
NEXT_PUBLIC_DEMO_USER_EMAIL=
# Offline cache + mutation queue (false = always hit live API)
NEXT_PUBLIC_OFFLINE_ENABLED=
# Verbose client debug logs (0 = off, 1 = on)
NEXT_PUBLIC_CLIENT_DEBUG=

# --- Mobile / Capacitor dev ---
# Capacitor webview / Next origin for live-reload against a tunnel or LAN IP
#MOBILE_DEV_URL=https://dev.sfivaz.com
# Override the origin Capacitor's WebView loads, defaults to MOBILE_DEV_URL
#CAPACITOR_SERVER_URL=

# --- Per-channel origin overrides (default to API_BASE_URL) ---
#NEXT_PUBLIC_API_BASE_URL=
#NEXT_PUBLIC_AUTH_BASE_URL=
#BETTER_AUTH_URL=

# --- Azure Deployment (Production) ---
# For Azure Container Apps:
# - All secrets stored in Azure Key Vault
# - Environment variables injected via Key Vault references
# - No .env file in container (secrets from managed identity)
# Example production values:
# API_BASE_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,capacitor://localhost
