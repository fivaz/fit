{
	"name": "@fit/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"dev:lan": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.build.json --noEmit",
		"start": "tsx src/main.ts",
		"lint": "eslint .",
		"db:setup": "prisma migrate dev",
		"db:reset": "prisma migrate reset --force",
		"db:full-reset": "pnpm run db:reset && pnpm run db:seed",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:generate": "prisma generate",
		"exercises-seed": "tsx scripts/exercises-seed.ts",
		"test:unit": "node --import tsx --test src/program/generate.test.ts"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.29",
		"@fit/shared": "workspace:*",
		"@nestjs/common": "^11.1.6",
		"@nestjs/core": "^11.1.6",
		"@nestjs/platform-express": "^11.1.6",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@sentry/node": "^10",
		"ai": "^7.0.51",
		"better-auth": "^1.4.9",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/express": "^5.0.3",
		"@types/node": "^20",
		"@types/pg": "^8.16.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.3.0",
		"prisma": "^7.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"typescript-eslint": "^8.46.4"
	}
}
